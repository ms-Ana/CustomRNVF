# CustomRNVF - OHDSI study execution
#
# This file contains ONLY orchestration: it wires together the OHDSI packages.
# No analytic logic and no SQL are authored here - all SQL is generated by the
# OHDSI packages (CirceR for cohorts, the analysis packages internally).

#' Execute the CustomRNVF study
#'
#' Runs, in order: cohort generation (CohortGenerator), cohort diagnostics
#' (CohortDiagnostics), characterization (Characterization) and incidence rate
#' calculation (CohortIncidence) against an OMOP CDM. Each step can be toggled.
#'
#' All cohort definitions are read from the package's \code{inst} folder, which is
#' populated from ATLAS by \code{extras/CreateCohortDefinitionSet.R}.
#'
#' @param connectionDetails    A \code{DatabaseConnector} connectionDetails object.
#' @param cdmDatabaseSchema    Schema holding the OMOP CDM data (read-only).
#' @param cohortDatabaseSchema Schema with write access for the cohort table.
#' @param cohortTable          Name of the cohort table to create/use.
#' @param outputFolder         Folder where all results are written.
#' @param databaseId           Short identifier for the CDM/source database.
#' @param targetIds            Cohort ids used as targets (characterization / incidence).
#' @param outcomeIds           Cohort ids used as outcomes (characterization / incidence).
#' @param minCellCount         Minimum cell count for result censoring.
#' @param tempEmulationSchema  Schema for emulated temp tables (Oracle/BigQuery/etc.).
#' @param createCohorts        Run cohort generation.
#' @param runCohortDiagnostics Run CohortDiagnostics.
#' @param runCharacterization  Run Characterization.
#' @param runIncidenceRate     Run incidence rate calculation.
#'
#' @return Invisibly returns \code{NULL}. Results are written under \code{outputFolder}.
#' @export
execute <- function(connectionDetails,
                    cdmDatabaseSchema,
                    cohortDatabaseSchema,
                    cohortTable = "custom_rnvf",
                    outputFolder,
                    databaseId,
                    targetIds,
                    outcomeIds,
                    minCellCount = 5,
                    tempEmulationSchema = getOption("sqlRenderTempEmulationSchema"),
                    createCohorts = TRUE,
                    runCohortDiagnostics = TRUE,
                    runCharacterization = TRUE,
                    runIncidenceRate = TRUE) {
  if (!dir.exists(outputFolder)) {
    dir.create(outputFolder, recursive = TRUE)
  }
  if (!is.null(tempEmulationSchema)) {
    options(sqlRenderTempEmulationSchema = tempEmulationSchema)
  }

  # ---- Logging ----------------------------------------------------------------
  ParallelLogger::clearLoggers()
  ParallelLogger::addDefaultFileLogger(file.path(outputFolder, "log.txt"))
  ParallelLogger::addDefaultErrorReportLogger(file.path(outputFolder, "errorReport.txt"))
  on.exit(ParallelLogger::unregisterLogger("DEFAULT_FILE_LOGGER", silent = TRUE), add = TRUE)
  on.exit(ParallelLogger::unregisterLogger("DEFAULT_ERRORREPORT_LOGGER", silent = TRUE), add = TRUE)

  # ---- Load cohort definition set (JSON + CirceR SQL from inst/) ---------------
  cohortDefinitionSet <- CohortGenerator::getCohortDefinitionSet(
    settingsFileName = "settings/CohortsToCreate.csv",
    jsonFolder = "cohorts",
    sqlFolder = "sql/sql_server",
    packageName = "CustomRNVF",
    verbose = FALSE
  )

  cohortTableNames <- CohortGenerator::getCohortTableNames(cohortTable = cohortTable)

  # ---- 1. Cohort generation ---------------------------------------------------
  if (createCohorts) {
    ParallelLogger::logInfo("Generating cohorts")
    CohortGenerator::createCohortTables(
      connectionDetails = connectionDetails,
      cohortDatabaseSchema = cohortDatabaseSchema,
      cohortTableNames = cohortTableNames,
      incremental = FALSE
    )
    CohortGenerator::generateCohortSet(
      connectionDetails = connectionDetails,
      cdmDatabaseSchema = cdmDatabaseSchema,
      cohortDatabaseSchema = cohortDatabaseSchema,
      cohortTableNames = cohortTableNames,
      cohortDefinitionSet = cohortDefinitionSet,
      tempEmulationSchema = tempEmulationSchema,
      incremental = FALSE
    )
    cohortCounts <- CohortGenerator::getCohortCounts(
      connectionDetails = connectionDetails,
      cohortDatabaseSchema = cohortDatabaseSchema,
      cohortTable = cohortTable
    )
    CohortGenerator::writeCsv(
      x = cohortCounts,
      file = file.path(outputFolder, "cohort_counts.csv")
    )
  }

  # ---- 2. Cohort diagnostics --------------------------------------------------
  if (runCohortDiagnostics) {
    ParallelLogger::logInfo("Running cohort diagnostics")
    CohortDiagnostics::executeDiagnostics(
      cohortDefinitionSet = cohortDefinitionSet,
      connectionDetails = connectionDetails,
      cdmDatabaseSchema = cdmDatabaseSchema,
      cohortDatabaseSchema = cohortDatabaseSchema,
      cohortTable = cohortTable,
      tempEmulationSchema = tempEmulationSchema,
      exportFolder = file.path(outputFolder, "cohortDiagnostics"),
      databaseId = databaseId,
      minCellCount = minCellCount,
      incremental = FALSE
    )
  }

  # ---- 3. Characterization ----------------------------------------------------
  if (runCharacterization) {
    ParallelLogger::logInfo("Running characterization")

    # Two time-at-risk windows: on-treatment and intent-to-treat (~1 year).
    # Covariate settings use the package defaults (baseline covariates +
    # during-cohort case covariates).
    aggregateOnTreatment <- Characterization::createAggregateCovariateSettings(
      targetIds = targetIds,
      outcomeIds = outcomeIds,
      riskWindowStart = 0,
      startAnchor = "cohort start",
      riskWindowEnd = 0,
      endAnchor = "cohort end"
    )
    aggregateIntentToTreat <- Characterization::createAggregateCovariateSettings(
      targetIds = targetIds,
      outcomeIds = outcomeIds,
      riskWindowStart = 0,
      startAnchor = "cohort start",
      riskWindowEnd = 365,
      endAnchor = "cohort start"
    )

    timeToEventSettings <- Characterization::createTimeToEventSettings(
      targetIds = targetIds,
      outcomeIds = outcomeIds
    )
    dechallengeRechallengeSettings <- Characterization::createDechallengeRechallengeSettings(
      targetIds = targetIds,
      outcomeIds = outcomeIds
    )

    characterizationSettings <- Characterization::createCharacterizationSettings(
      timeToEventSettings = list(timeToEventSettings),
      dechallengeRechallengeSettings = list(dechallengeRechallengeSettings),
      aggregateCovariateSettings = list(aggregateOnTreatment, aggregateIntentToTreat)
    )

    Characterization::runCharacterizationAnalyses(
      connectionDetails = connectionDetails,
      cdmDatabaseSchema = cdmDatabaseSchema,
      targetDatabaseSchema = cohortDatabaseSchema,
      targetTable = cohortTable,
      outcomeDatabaseSchema = cohortDatabaseSchema,
      outcomeTable = cohortTable,
      tempEmulationSchema = tempEmulationSchema,
      characterizationSettings = characterizationSettings,
      outputDirectory = file.path(outputFolder, "characterization"),
      databaseId = databaseId,
      minCellCount = minCellCount
    )
  }

  # ---- 4. Incidence rate ------------------------------------------------------
  if (runIncidenceRate) {
    ParallelLogger::logInfo("Calculating incidence rates")

    targets <- lapply(targetIds, function(id) {
      CohortIncidence::createCohortRef(
        id = id,
        name = cohortDefinitionSet$cohortName[cohortDefinitionSet$cohortId == id]
      )
    })
    outcomeDefs <- lapply(seq_along(outcomeIds), function(i) {
      CohortIncidence::createOutcomeDef(
        id = i,
        name = cohortDefinitionSet$cohortName[cohortDefinitionSet$cohortId == outcomeIds[i]],
        cohortId = outcomeIds[i],
        cleanWindow = 365
      )
    })

    # On-treatment: cohort start -> cohort end. ITT: cohort start -> +365 days
    # (clipped at the end of the observation period by CohortIncidence).
    tarOnTreatment <- CohortIncidence::createTimeAtRiskDef(
      id = 1, startWith = "start", endWith = "end"
    )
    tarIntentToTreat <- CohortIncidence::createTimeAtRiskDef(
      id = 2, startWith = "start", endWith = "start", endOffset = 365
    )

    analysis <- CohortIncidence::createIncidenceAnalysis(
      targets = targetIds,
      outcomes = seq_along(outcomeIds),
      tars = c(1, 2)
    )

    irDesign <- CohortIncidence::createIncidenceDesign(
      targetDefs = targets,
      outcomeDefs = outcomeDefs,
      tars = list(tarOnTreatment, tarIntentToTreat),
      analysisList = list(analysis)
    )

    buildOptions <- CohortIncidence::buildOptions(
      cohortTable = paste(cohortDatabaseSchema, cohortTable, sep = "."),
      cdmDatabaseSchema = cdmDatabaseSchema,
      sourceName = databaseId,
      refId = 1
    )

    irResults <- CohortIncidence::executeAnalysis(
      connectionDetails = connectionDetails,
      incidenceDesign = irDesign,
      buildOptions = buildOptions
    )

    incidenceFolder <- file.path(outputFolder, "incidence")
    if (!dir.exists(incidenceFolder)) {
      dir.create(incidenceFolder, recursive = TRUE)
    }
    utils::write.csv(
      irResults$incidenceSummary,
      file.path(incidenceFolder, "incidence_summary.csv"),
      row.names = FALSE
    )
  }

  ParallelLogger::logInfo("CustomRNVF execution complete. Results in: ", outputFolder)
  invisible(NULL)
}
